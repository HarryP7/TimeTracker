<Window x:Class="TimeTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeTracker"
        mc:Ignorable="d"
        Title="Time Tracker" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Блок выбора даты и общего времени -->
        <Border Grid.Row="0" Background="#f8f9fa" Padding="10" CornerRadius="5" Margin="0,0,0,15">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="Дата просмотра:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Всего за день: " VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalTimeFormatted}" VerticalAlignment="Center" FontSize="16" Foreground="#2c3e50" FontWeight="Black"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Блок добавления задачи -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="14" Padding="6" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Добавить задачу" Command="{Binding AddCommand}" 
                    Padding="20,5" FontSize="14" Background="#3498db" Foreground="White" BorderThickness="0"/>
        </Grid>

        <!-- Основная таблица задач -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                  Background="White" RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название задачи" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Всего за день" Binding="{Binding FormattedTotalTime}" Width="120" IsReadOnly="True"/>

                <!-- Кнопка «+» для добавления подзадачи -->
                <DataGridTemplateColumn Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="＋" Command="{Binding DataContext.AddSubTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                    CommandParameter="{Binding}" Margin="2" Background="#3498db" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <!-- Детали строки: Список подзадач, разворачивается при выборе задачи -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#f1f2f6" Padding="10" BorderBrush="#dcdde1" BorderThickness="0,1,0,1">
                        <StackPanel>
                            <TextBlock Text="Подзадачи и логи времени:" FontWeight="Bold" Margin="5,0,0,5" Foreground="#57606f"/>
                            <DataGrid ItemsSource="{Binding SubTasks}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      HeadersVisibility="None" Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding FormattedUpdatedAt}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding DisplayName}" Width="680"/>
                                    <DataGridTextColumn Binding="{Binding FormattedTime}" Width="110" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ButtonText}" 
                                                        Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                        CommandParameter="{Binding}" Margin="2" Padding="10,2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>

</Window>
