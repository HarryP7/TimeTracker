<Window x:Class="TimeTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeTracker"
        mc:Ignorable="d"
        Title="Time Tracker" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя аналитическая панель -->
        <Border Grid.Row="0" Background="#f8f9fa" Padding="12" CornerRadius="6" Margin="0,0,0,15" BorderBrush="#e9ecef" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Дата :" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="Bold"/>
                    <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="110" Margin="0,0,15,0"/>

                    <TextBlock Text="Начало работы:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#7f8c8d"/>
                    <TextBlock Text="{Binding StartTimeFormatted}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0" Foreground="#2980b9"/>

                    <TextBlock Text="Паузы:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#7f8c8d"/>
                    <TextBlock Text="{Binding TotalPauseFormatted}" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,15,0" Foreground="#e67e22"/>
                </StackPanel>

                <!-- Индикатор обеда и расчет окончания -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox IsChecked="{Binding IsLunchIncluded, Mode=TwoWay}" Content="Был обед" VerticalAlignment="Center" Margin="0,0,10,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Завершение в: " VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding EstimatedEndTimeFormatted}" VerticalAlignment="Center" FontSize="15"
                               Foreground="#27ae60" FontWeight="Black" Margin="0,0,15,0"/>

                    <TextBlock Text="Всего за день: " VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalTimeFormatted}" VerticalAlignment="Center" FontSize="15" Foreground="#2c3e50" FontWeight="Black"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Блок добавления задачи -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}" 
                     FontSize="14" Padding="6" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="1" Content="Добавить задачу" Command="{Binding AddCommand}" 
                    Padding="20,5" FontSize="14" Background="#3498db" Foreground="White" BorderThickness="0"/>
        </Grid>

        <!-- Основная таблица задач -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Tasks}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" 
                  Background="White" RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название задачи" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Всего за день" Binding="{Binding FormattedTotalTime}" Width="120" IsReadOnly="True"/>

                <DataGridTemplateColumn Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <!-- Кнопка добавления подзадачи -->
                                <Button Content="＋" Command="{Binding DataContext.AddSubTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Width="35" Margin="2" Background="#3498db" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
                                <!-- Удаление главной задачи -->
                                <Button Content="❌" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}" Width="35" Margin="2" Background="#e74c3c" Foreground="White" BorderThickness="0"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

            <!-- Детали строки: Список подзадач, разворачивается при выборе задачи -->
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Background="#f1f2f6" Padding="10" BorderBrush="#dcdde1" BorderThickness="0,1,0,1">
                        <StackPanel>
                            <!--<TextBlock Text="Подзадачи:" FontWeight="Bold" Margin="5,0,0,5" Foreground="#57606f"/>-->
                            <DataGrid ItemsSource="{Binding SubTasks}" AutoGenerateColumns="False" CanUserAddRows="False" 
                                      HeadersVisibility="None" Background="Transparent" BorderThickness="0" GridLinesVisibility="None" IsReadOnly="True">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="ToolTip" Value="{Binding FormattedUpdatedAt}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding DisplayName}" Width="640" />
                                    <DataGridTextColumn Binding="{Binding FormattedTime}" Width="90" />
                                    <DataGridTemplateColumn Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="50"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Кнопка «Плей» для запуска таймера выполнения родзадачи -->
                                                    <Button Grid.Column="0" Content="{Binding ButtonText}"
                                                        Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Margin="2" Padding="8,2"/>

                                                    <!-- Кнопка «Карандаш» для вызова Попапа корректировки -->
                                                    <ToggleButton x:Name="EditTimeBtn" Grid.Column="1" Content="✏️" Margin="2" Padding="4,2"
                                                              Background="#f1c40f" BorderThickness="0"/>

                                                    <!-- Удаление отдельной подзадачи -->
                                                    <Button Grid.Column="2" Content="❌"
                                                        Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" Margin="2" Padding="4,2" Background="#e74c3c" Foreground="White" BorderThickness="0"/>

                                                    <!-- POPUP коррекции времени -->
                                                    <Popup IsOpen="{Binding IsChecked, ElementName=EditTimeBtn, Mode=TwoWay}"
                                                       StaysOpen="False" Placement="Left" AllowsTransparency="True">
                                                        <Border Background="White" CornerRadius="5" Padding="10" BorderBrush="#bdc3c7" BorderThickness="1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBox Text="{Binding DataContext.AdjustHours, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                     Width="25" TextAlignment="Center" Margin="2"/>
                                                                <TextBlock Text="ч" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </Grid>

</Window>
