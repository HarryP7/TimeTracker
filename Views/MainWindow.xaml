<Window x:Class="TimeTracker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TimeTracker"
        mc:Ignorable="d"
        Title="Time Tracker" Height="680" Width="980"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F4F6FA" TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- ============ Палитра ============ -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#4F6BED"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#22A06B"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#e67e22"/>
        <SolidColorBrush x:Key="YellowBrush" Color="#f1c40f"/>
        <SolidColorBrush x:Key="DangerBrush" Color="#d3383d"/>
        <SolidColorBrush x:Key="PurpleBrush" Color="#8E44AD"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#303030"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2937"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7684"/>
        <SolidColorBrush x:Key="BorderBrushLight" Color="#E3E8EF"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TileBackgroundBrush" Color="#F7F9FC"/>

        <!-- ============ Тени карточек ============ -->
        <DropShadowEffect x:Key="CardShadow" Color="#1F2937" Opacity="0.08" BlurRadius="18" ShadowDepth="2" Direction="270"/>
        <DropShadowEffect x:Key="PopupShadow" Color="#1F2937" Opacity="0.22" BlurRadius="22" ShadowDepth="4" Direction="270"/>

        <!-- ============ Основная кнопка (цветная, скруглённая) ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Компактная цветная кнопка-иконка ============ -->
        <Style x:Key="ColorIconButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- ============ Прозрачная кнопка-иконка (ghost) ============ -->
        <Style x:Key="GhostIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EEF7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D8E0EF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ ToggleButton для попапа времени ============ -->
        <Style x:Key="TimeToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E9EEF7"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE6FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Текстовое поле ============ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#B9C4D6"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Заголовки столбцов таблицы ============ -->
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F4F9"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <!-- ============ Ячейки таблицы ============ -->
        <Style x:Key="GridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Строки таблицы (подсветка при наведении) ============ -->
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="44"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF4FC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E6EDFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Главная таблица ============ -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFBFD"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeaderStyle}"/>
            <Setter Property="CellStyle" Value="{StaticResource GridCellStyle}"/>
            <Setter Property="RowStyle" Value="{StaticResource GridRowStyle}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <!-- ============ Вложенная таблица подзадач ============ -->
        <Style x:Key="SubGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="38"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E9F0FB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Метки и значения метрик ============ -->
        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ============ Подпись контекста ============ -->
        <Style x:Key="ContextLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ContextValue" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Верхняя аналитическая панель ================= -->
        <Border Grid.Row="0" Background="{StaticResource CardBackgroundBrush}"
                CornerRadius="12" Padding="18,14" Margin="0,0,0,16"
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Строка контекста дня: дата, начало, паузы, обед, кнопка завершения -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Дата:" Style="{StaticResource ContextLabel}"/>
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="120"
                                    Margin="0,0,22,0" VerticalAlignment="Center" FontSize="13"/>

                        <TextBlock Text="Начало работы:" Style="{StaticResource ContextLabel}"/>
                        <TextBlock Text="{Binding StartTimeFormatted}" Style="{StaticResource ContextValue}"
                                   Foreground="{StaticResource PrimaryBrush}"/>

                        <TextBlock Text="Паузы:" Style="{StaticResource ContextLabel}"/>
                        <TextBlock Text="{Binding TotalPauseFormatted}" Style="{StaticResource ContextValue}"
                                   Foreground="{StaticResource WarningBrush}"/>

                        <CheckBox IsChecked="{Binding IsLunchIncluded, Mode=TwoWay}" Content="Был обед"
                                  VerticalAlignment="Center" Margin="0,0,10,0" FontSize="13"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </WrapPanel>

                    <Button Grid.Column="1" Content="✔  Завершение работы"
                            Command="{Binding CompleteWorkCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Background="{StaticResource SuccessBrush}"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsCompleteButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </Grid>

                <!-- Сводка дня: четыре ключевые метрики в плитках -->
                <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="0,14,0,0">
                    <!-- Всего за день -->
                    <Border Background="{StaticResource TileBackgroundBrush}" CornerRadius="10"
                            Padding="14,10" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="ВСЕГО ЗА ДЕНЬ" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding TotalTimeFormatted}" Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Прогнозное завершение -->
                    <Border Background="{StaticResource TileBackgroundBrush}" CornerRadius="10"
                            Padding="14,10" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="ПРОГНОЗ ЗАВЕРШЕНИЯ" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding EstimatedEndTimeFormatted}" Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Фактическое завершение -->
                    <Border Background="{StaticResource TileBackgroundBrush}" CornerRadius="10"
                            Padding="14,10" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="ФАКТ ЗАВЕРШЕНИЯ" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding WorkEndTimeFormatted}" Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource PrimaryBrush}"
                                       Visibility="{Binding IsWorkCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Text="—" Style="{StaticResource MetricValue}" Foreground="#B7BFCC"
                                       Visibility="{Binding IsWorkCompleted, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Баланс времени -->
                    <Border Background="{StaticResource TileBackgroundBrush}" CornerRadius="10"
                            Padding="14,10" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="БАЛАНС ВРЕМЕНИ" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding TimeBalanceFormatted}" Style="{StaticResource MetricValue}"
                                       Foreground="{StaticResource PurpleBrush}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Border>

        <!-- ================= Заголовок секции ================= -->
        <TextBlock Grid.Row="1" Text="Задачи дня" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0,0,10"/>

        <!-- ================= Блок добавления задачи ================= -->
        <Border Grid.Row="2" Background="{StaticResource CardBackgroundBrush}" CornerRadius="10"
                Padding="12" Margin="0,0,0,14"
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="NewTaskBox" Style="{StaticResource ModernTextBox}" FontSize="14"
                             Text="{Binding NewTaskName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Название новой задачи…" Foreground="#9AA4B2" Margin="13,0,0,0"
                               IsHitTestVisible="False" VerticalAlignment="Center" FontSize="14">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=NewTaskBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <Button Grid.Column="1" Content="＋  Добавить задачу" Command="{Binding AddCommand}"
                        Style="{StaticResource PrimaryButton}" FontSize="14" Padding="20,9"/>
            </Grid>
        </Border>

        <!-- ================= Основная таблица задач ================= -->
        <Border Grid.Row="3" Background="{StaticResource CardBackgroundBrush}" CornerRadius="12"
                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
                ClipToBounds="True">
            <DataGrid Style="{StaticResource ModernDataGrid}"
                      ItemsSource="{Binding Tasks}" AutoGenerateColumns="False"
                      CanUserAddRows="False" Background="Transparent"
                      RowDetailsVisibilityMode="Visible"
                      ScrollViewer.CanContentScroll="False"
                      VirtualizingPanel.IsVirtualizing="False">
                <DataGrid.Columns>
                    <!-- Кнопка раскрытия/скрытия подзадач -->
                    <DataGridTemplateColumn Width="42">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding IsExpanded, Converter={StaticResource ExpandCollapseConverter}}"
                                        Command="{Binding ToggleExpandCommand}"
                                        Style="{StaticResource GhostIconButton}" FontSize="11"
                                        ToolTip="Раскрыть/скрыть подзадачи"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Название задачи" Binding="{Binding Name}"
                                        Foreground="{Binding TaskTextColor}" Width="*"
                                        FontSize="13" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Всего за день" Binding="{Binding FormattedTotalTime}"
                                        Width="110" FontSize="13" FontWeight="SemiBold" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="Действия" Width="118">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <!-- Кнопка добавления подзадачи -->
                                    <Button Content="＋" Command="{Binding DataContext.AddSubTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource ColorIconButton}"
                                            Background="{StaticResource PrimaryBrush}"
                                            ToolTip="Добавить подзадачу"/>
                                    <!-- Редактирование названия задачи -->
                                    <Button Content="✏️" Command="{Binding DataContext.EditTaskNameCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Margin="6,0,0,0"
                                            Style="{StaticResource GhostIconButton}"
                                            Background="{StaticResource YellowBrush}"
                                            Foreground="{StaticResource DarkBrush}"
                                            ToolTip="Изменить название задачи"/>
                                    <!-- Удаление главной задачи -->
                                    <Button Content="🗑" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}" Margin="6,0,0,0"
                                            Style="{StaticResource GhostIconButton}"
                                            Foreground="{StaticResource DangerBrush}"
                                            ToolTip="Удалить задачу"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <!-- Детали строки: список подзадач -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="#F7F9FC" CornerRadius="10" Padding="12,8" Margin="6,2,10,8"
                                BorderBrush="{StaticResource BorderBrushLight}" BorderThickness="1"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <DataGrid ItemsSource="{Binding SubTasks}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" HeadersVisibility="None"
                                      Background="Transparent" BorderThickness="0"
                                      GridLinesVisibility="None" IsReadOnly="True"
                                      RowBackground="Transparent" AlternatingRowBackground="#EFF3FA"
                                      RowHeaderWidth="0" CellStyle="{StaticResource GridCellStyle}"
                                      Focusable="False" IsTabStop="False"
                                      ScrollViewer.CanContentScroll="False"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow" BasedOn="{StaticResource SubGridRowStyle}">
                                        <Setter Property="ToolTip" Value="{Binding FormattedUpdatedAt}"/>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <!-- Кнопка «Плей» для запуска таймера выполнения подзадачи -->
                                    <DataGridTemplateColumn Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding PlayBtnText}"
                                                        Command="{Binding DataContext.ToggleTimerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ColorIconButton}"
                                                        Background="{StaticResource SuccessBrush}"
                                                        ToolTip="Запустить / остановить таймер"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Binding="{Binding DisplayName}" Width="*" FontSize="13"/>
                                    <DataGridTextColumn Binding="{Binding FormattedTime}" Width="90"
                                                        FontSize="13" FontWeight="SemiBold"/>

                                    <!-- Действия с подзадачей -->
                                    <DataGridTemplateColumn Width="118">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Left">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Кнопка «Время» для вызова попапа корректировки времени -->
                                                    <ToggleButton x:Name="EditTimeBtn" Grid.Column="0" Content="🕓"
                                                                  Style="{StaticResource TimeToggleBtn}"
                                                                  Background="{StaticResource YellowBrush}"
                                                                  Foreground="{StaticResource DarkBrush}"
                                                                  ToolTip="Изменить время подзадачи"/>

                                                    <!-- Кнопка «Карандаш» для изменения названия подзадачи -->
                                                    <Button Content="✏️" Grid.Column="1" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.EditSubTaskNameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostIconButton}"
                                                            Background="{StaticResource YellowBrush}"
                                                            Foreground="{StaticResource DarkBrush}"
                                                            ToolTip="Изменить название подзадачи"/>

                                                    <!-- Удаление отдельной подзадачи -->
                                                    <Button Grid.Column="2" Content="🗑" Margin="6,0,0,0"
                                                            Command="{Binding DataContext.DeleteSubTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostIconButton}"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            ToolTip="Удалить подзадачу"/>

                                                    <!-- Попап коррекции времени -->
                                                    <Popup IsOpen="{Binding IsChecked, ElementName=EditTimeBtn, Mode=TwoWay}"
                                                           StaysOpen="False" Placement="Top" AllowsTransparency="True">
                                                        <Border Background="White" CornerRadius="10" Padding="14,12"
                                                                BorderBrush="{StaticResource BorderBrushLight}"
                                                                BorderThickness="1" Effect="{StaticResource PopupShadow}">
                                                            <StackPanel Orientation="Vertical">
                                                                <TextBlock Text="Корректировка времени" FontSize="12"
                                                                           FontWeight="SemiBold" Margin="0,0,0,8"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                                                <!-- Блок ввода и изменения времени -->
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <!-- Кнопка Минус -->
                                                                    <Button Content="−"
                                                                            Command="{Binding DataContext.DecreaseTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            Style="{StaticResource ColorIconButton}"
                                                                            Background="{StaticResource DangerBrush}"
                                                                            Width="26" Height="26" Margin="0,0,6,0"
                                                                            ToolTip="Уменьшить на 1 час"/>

                                                                    <!-- Часы -->
                                                                    <TextBox Text="{Binding DataContext.EditHours, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                             Style="{StaticResource ModernTextBox}"
                                                                             Width="36" TextAlignment="Center" Padding="2,5" MaxLength="2"/>
                                                                    <TextBlock Text=":" FontWeight="Bold" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0"/>

                                                                    <!-- Минуты -->
                                                                    <TextBox Text="{Binding DataContext.EditMinutes, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                             Style="{StaticResource ModernTextBox}"
                                                                             Width="36" TextAlignment="Center" Padding="2,5" MaxLength="2"/>
                                                                    <TextBlock Text=":" FontWeight="Bold" VerticalAlignment="Center"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="2,0"/>

                                                                    <!-- Секунды -->
                                                                    <TextBox Text="{Binding DataContext.EditSeconds, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                                                             Style="{StaticResource ModernTextBox}"
                                                                             Width="36" TextAlignment="Center" Padding="2,5" MaxLength="2"/>

                                                                    <!-- Кнопка Плюс -->
                                                                    <Button Content="+"
                                                                            Command="{Binding DataContext.IncreaseTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            Style="{StaticResource ColorIconButton}"
                                                                            Background="{StaticResource SuccessBrush}"
                                                                            Width="26" Height="26" Margin="6,0,0,0"
                                                                            ToolTip="Увеличить на 1 час"/>
                                                                </StackPanel>

                                                                <!-- Кнопка Применить -->
                                                                <Button Content="{Binding DataContext.ApplyEditTimeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        Command="{Binding DataContext.SaveSubtaskTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource PrimaryButton}"
                                                                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="5,7"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Border>
    </Grid>

</Window>
